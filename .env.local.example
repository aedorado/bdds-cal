# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real value here.
#
# The same values go into Vercel -> Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------


# --- Supabase ---------------------------------------------------------------
# Dashboard -> Project Settings -> API

# Safe in the browser: it identifies the project, it does not authorise
# anything. Row Level Security and the public_events view are what actually
# protect the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only, and completely different in kind: it BYPASSES RLS and can read
# and write every table. Never prefix it NEXT_PUBLIC_, never import it into a
# client component. src/utils/supabase/admin.ts imports "server-only" so that
# mistake fails the build instead of leaking data.
#
# Create it under Project Settings -> API Keys -> "Secret keys" (it starts
# sb_secret_ and is shown in full only once). Used solely by the notification
# runner, which acts on behalf of nobody and must read every team member's
# push subscription.
SUPABASE_SECRET_KEY=


# --- Web push (VAPID) -------------------------------------------------------
# Generate a pair once, then keep them forever:
#
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# Changing these invalidates every existing push subscription silently -
# devices stay subscribed and simply never receive anything again. If you ever
# do rotate them, everyone must turn notifications off and on to re-subscribe.

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact address push services can reach you at, as a mailto: URI.
# Required by the VAPID spec; some push services reject requests without it.
VAPID_SUBJECT=mailto:you@example.com


# --- Scheduler --------------------------------------------------------------
# Shared secret so that only Supabase Cron can trigger a notification run.
# /api/notifications/run rejects anything without a matching x-cron-secret
# header. Generate one with:
#
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# The same value goes into supabase/migrations/0004_cron.sql, which stores it
# in Supabase Vault rather than leaving it readable in the cron.job table.
CRON_SECRET=


# --- Not needed here --------------------------------------------------------
# Google OAuth client ID and secret are NOT read by this app. Supabase holds
# them: Authentication -> Providers -> Google. Google's authorised redirect URI
# must be Supabase's callback, not this app's:
#
#   https://<your-project-ref>.supabase.co/auth/v1/callback
#
# This app's own URL belongs in Supabase under Authentication -> URL
# Configuration -> Redirect URLs (e.g. http://localhost:3002/** and your
# deployed URL).
